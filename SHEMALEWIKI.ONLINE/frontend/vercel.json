{
  "framework": "vite",
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/image(.*)", "destination": "/api/image.js" },
    { "source": "/api/admin(.*)", "destination": "/api/admin.js" },
    { "source": "/api/admin/login(.*)", "destination": "/api/admin.js" },
    { "source": "/api/register(.*)", "destination": "/api/register.js" },
    { "source": "/api/claims(.*)", "destination": "/api/claims.js" },
    { "source": "/api/contact(.*)", "destination": "/api/contact.js" },
    { "source": "/api/upload-photos(.*)", "destination": "/api/upload-photos.js" },
    { "source": "/api/manage-photos(.*)", "destination": "/api/manage-photos.js" },
    { "source": "/api/update-profile(.*)", "destination": "/api/update-profile.js" },
    { "source": "/api/drafts(.*)", "destination": "/api/profiles.js" },
    { "source": "/api/vivas/chat(.*)", "destination": "/api/vivas/chat.js" },
    { "source": "/api/auth/login(.*)", "destination": "/api/auth/login.js" },
    { "source": "/api/profiles(.*)", "destination": "/api/profiles.js" },
    { "source": "/api/profiles/(.*)", "destination": "/api/profiles.js" },
    { "source": "/((?!assets/|api/|vivas/|_expo/|favicon|robots|sitemap|llms|logosw|icons|city-guides|downloads|mision|manifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co https://api.shemalewiki.online; script-src 'self' 'unsafe-inline' https://qtuzpswxzengqoqqwtpt.supabase.co https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; connect-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co wss://qtuzpswxzengqoqqwtpt.supabase.co https://shemalewiki.online https://buscatrans.com https://vercel.live https://api.shemalewiki.online; frame-src 'self' https://vercel.live;"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "x-vercel-skip-toolbar", "value": "1" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:svg|png|ico|jpg|jpeg|webp|gif|woff|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots|sitemap|sitemap-main|manifest|llms)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
